#!/bin/bash
set -e

if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <path_to_deb>"
    exit 1
fi

INPUT_DEB="$1"
BASE_NAME="$(basename "$INPUT_DEB" .deb)"
WORK_DIR="work_patcher_$(date +%s)"
OUTPUT_DEB="${BASE_NAME}_roothide.deb"

echo "[*] Unpacking package..."
mkdir -p "$WORK_DIR/pkg"
dpkg-deb -R "$INPUT_DEB" "$WORK_DIR/pkg"

CONTROL_FILE="$WORK_DIR/pkg/DEBIAN/control"

echo "[*] Patching control metadata..."
sed -i 's/^Architecture:.*/Architecture: iphoneos-arm64e/I' "$CONTROL_FILE"

# Clean any existing Pre-Depends patches- tags
sed -i '/^Pre-Depends:.*patches-/d' "$CONTROL_FILE"

# Append ~roothide tag
CURRENT_VER=$(grep -i "^Version:" "$CONTROL_FILE" | head -n 1 | awk '{print $2}')
if [[ "$CURRENT_VER" != *"~roothide"* ]]; then
    sed -i "s/^Version:.*/Version: ${CURRENT_VER}~roothide/I" "$CONTROL_FILE"
fi

echo "[*] Patching Mach-O binaries..."
find "$WORK_DIR/pkg" -type f | while read -r file; do
    if otool -h "$file" &> /dev/null; then
        echo "    Processing: $(basename "$file")"
        
        # Extract linked libraries and replace with valid @loader_path/.jbroot links
        otool -L "$file" | awk 'NR>1 {print $1}' | while read -r lib; do
            case "$lib" in
                /Library/*|/usr/lib/*|/var/jb/*|\\@loader_path/*)
                    # Clean any leading backslashes or /var/jb prefixes
                    clean_lib="${lib#\\}"
                    clean_lib="${clean_lib#/var/jb}"
                    
                    target="@loader_path/.jbroot${clean_lib}"
                    
                    echo "       $lib -> $target"
                    install_name_tool -change "$lib" "$target" "$file" 2>/dev/null || true
                    ;;
            esac
        done
        
        # Add RootHide fallback rpaths
        install_name_tool -add_rpath "@loader_path/.jbroot/usr/lib" "$file" 2>/dev/null || true
        install_name_tool -add_rpath "@loader_path/.jbroot/Library/Frameworks" "$file" 2>/dev/null || true
        
        # Strip and resign cleanly
        ldid -S "$file" 2>/dev/null || true
    fi
done

echo "[*] Setting file permissions..."
find "$WORK_DIR/pkg/DEBIAN" -type f ! -name "control" -exec chmod 755 {} +

echo "[*] Packing final .deb..."
dpkg-deb -Zxz --root-owner-group -b "$WORK_DIR/pkg" "$OUTPUT_DEB"

rm -rf "$WORK_DIR"
echo "[+] Done: $OUTPUT_DEB"